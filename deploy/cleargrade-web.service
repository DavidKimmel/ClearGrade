[Unit]
Description=ClearGrade Web API
After=network.target

[Service]
User=www-data
WorkingDirectory=/var/www/cleargrade
EnvironmentFile=/var/www/cleargrade/.env
ExecStart=/usr/local/bin/gunicorn --bind 127.0.0.1:8000 --workers 2 "app.server:create_app()"
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
